#!/usr/bin/python3
"""GPIO117 light endpoint, restricted to the Klipper host and loopback."""
from http.server import BaseHTTPRequestHandler, HTTPServer
from pathlib import Path
import json
import time

SETTINGS = json.loads(Path('/etc/s1-settings.json').read_text())
GPIO = Path('/sys/class/gpio/gpio117')

def initialize():
    if not GPIO.exists():
        Path('/sys/class/gpio/export').write_text('117')
    for _ in range(20):
        if (GPIO / 'direction').exists():
            break
        time.sleep(0.05)
    if (GPIO / 'direction').read_text().strip() != 'out':
        (GPIO / 'direction').write_text('high')

class Handler(BaseHTTPRequestHandler):
    def log_request(self, code='-', size='-'):
        if self.command == 'POST' or code != 200:
            super().log_request(code, size)

    def handle_command(self, change):
        self.connection.settimeout(3)
        if self.client_address[0] not in (SETTINGS['pi_ip'], '127.0.0.1'):
            self.send_error(403)
            return
        paths = {'/light/status': None, '/light/on': '1', '/light/off': '0'}
        if self.path not in paths:
            self.send_error(404)
            return
        value = paths[self.path]
        if (value is not None) != change:
            self.send_error(405)
            return
        try:
            if value is not None:
                (GPIO / 'value').write_text(value)
            state = 'on' if (GPIO / 'value').read_text().strip() == '1' else 'off'
            body = json.dumps({'state': state}).encode()
        except OSError:
            self.send_error(503, 'GPIO unavailable')
            return
        self.send_response(200)
        self.send_header('Content-Type', 'application/json')
        self.send_header('Content-Length', str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        self.handle_command(False)

    def do_POST(self):
        self.handle_command(True)

class Server(HTTPServer):
    def get_request(self):
        connection, address = super().get_request()
        connection.settimeout(3)
        return connection, address

if __name__ == '__main__':
    initialize()
    Server(('0.0.0.0', 7126), Handler).serve_forever()
