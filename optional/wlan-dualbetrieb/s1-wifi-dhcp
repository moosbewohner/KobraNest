#!/usr/bin/python3
"""DHCP hook: own WLAN address, low-priority routes; never moves LAN address."""
import ipaddress,json,os,pathlib,subprocess,sys
P=pathlib.Path;IP='/usr/sbin/ip'
interface=os.environ.get('interface')
config=json.loads(P('/etc/s1-dual-network.json').read_text())
if interface=='wlan0':metric='600';state=P('/run/s1/wifi.lease.json')
elif interface=='eth1' and config.get('primary_interface')=='wlan0':metric='700';state=P('/run/s1/lan.lease.json')
else:raise SystemExit(1)
def ip(*args):return subprocess.run([IP,*args],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,timeout=10).returncode
event=sys.argv[1]
old=json.loads(state.read_text()) if state.exists() else {}
def clear():
 if old.get('address'):
  ip('addr','del',old['address'],'dev',interface)
  ip('route','del',str(ipaddress.ip_interface(old['address']).network),'dev',interface,'metric',metric)
 ip('route','del','default','dev',interface,'metric',metric)
 state.unlink(missing_ok=True)
if event=='deconfig':clear();raise SystemExit(0)
if event not in ('bound','renew'):raise SystemExit(0)
address=ipaddress.IPv4Interface(os.environ['ip']+'/'+os.environ.get('subnet','255.255.255.0'))
config=json.loads(P('/etc/s1-dual-network.json').read_text())
if ((interface=='wlan0' and config.get('primary_interface','eth1')=='eth1') or interface=='eth1') and address.ip==ipaddress.ip_interface(config['address']).ip:
 raise SystemExit('DHCP offered reserved LAN address; assign a separate WLAN reservation in router')
if old.get('address') and old['address']!=str(address):clear()
if ip('addr','replace',str(address),'dev',interface,'noprefixroute'):raise SystemExit(1)
ip('route','replace',str(address.network),'dev',interface,'src',str(address.ip),'metric',metric)
routers=os.environ.get('router','').split()
if routers:ip('route','replace','default','via',str(ipaddress.IPv4Address(routers[0])),'dev',interface,'onlink','metric',metric)
state.write_text(json.dumps({'address':str(address),'router':routers[:1]})+'\n')
print(interface+' SSH address:',str(address),flush=True)
