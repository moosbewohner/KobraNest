#!/usr/bin/python3
"""Reload only an RTL8153 Ethernet interface if its factory MAC was not used.
Reads the same PLA_BACKUP register as upstream r8152; never writes EEPROM/MAC.
"""
import ctypes,os,subprocess,time
from pathlib import Path

def factory_mac(device):
 class Control(ctypes.Structure):
  _fields_=[('requesttype',ctypes.c_uint8),('request',ctypes.c_uint8),('value',ctypes.c_uint16),('index',ctypes.c_uint16),('length',ctypes.c_uint16),('timeout',ctypes.c_uint32),('data',ctypes.c_void_p)]
 node='/dev/bus/usb/%03d/%03d'%(int((device/'busnum').read_text()),int((device/'devnum').read_text()))
 fd=os.open(node,os.O_RDWR)
 try:
  buf=ctypes.create_string_buffer(8)
  request=Control(0xc0,5,0xd000,0x100,8,1000,ctypes.cast(buf,ctypes.c_void_p))
  libc=ctypes.CDLL(None,use_errno=True)
  result=libc.ioctl(fd,ctypes.c_ulong(0xc0005500|(ctypes.sizeof(Control)<<16)),ctypes.byref(request))
  if result!=8:raise RuntimeError('Factory MAC read failed')
  mac=buf.raw[:6]
  if mac[0]&1 or mac in (b'\0'*6,b'\xff'*6):raise RuntimeError('Invalid factory MAC')
  return mac.hex(':')
 finally:os.close(fd)

def main():
 net=Path('/sys/class/net/eth1')
 if not net.exists():return
 interface=(net/'device').resolve()
 if (interface/'driver').resolve().name!='r8152':return
 device=interface
 while not (device/'idVendor').exists():
  if device==device.parent:return
  device=device.parent
 if (device/'idVendor').read_text().strip()!='0bda' or (device/'idProduct').read_text().strip()!='8153':return
 if not Path('/lib/firmware/rtl_nic/rtl8153b-2.fw').is_file():return
 identity=(device/'busnum').read_text().strip()+'-'+(device/'devnum').read_text().strip()
 marker=Path('/run/s1/realtek-'+identity+'.checked')
 if marker.exists():return
 expected=factory_mac(device)
 marker.parent.mkdir(parents=True,exist_ok=True)
 marker.write_text(expected+'\n')
 if (net/'address').read_text().strip().lower()==expected:return
 print('RTL8153 factory MAC differs; reinitializing Ethernet interface with firmware available.',flush=True)
 driver=Path('/sys/bus/usb/drivers/r8152')
 (driver/'unbind').write_text(interface.name)
 try:time.sleep(0.5)
 finally:(driver/'bind').write_text(interface.name)
 for _ in range(30):
  if (net/'address').exists():break
  time.sleep(0.1)
 actual=(net/'address').read_text().strip().lower()
 if actual!=expected:raise RuntimeError('Driver still does not use factory MAC; no address was forced')
 print('RTL8153 driver restored factory MAC: '+actual,flush=True)

if __name__=='__main__':
 try:main()
 except (OSError,RuntimeError,ValueError) as error:
  print('RTL8153 initialization: '+str(error),flush=True)
  raise SystemExit(1)
