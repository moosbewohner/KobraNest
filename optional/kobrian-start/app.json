{
  "$version": "1",
  "name": "Start KobraNest",
  "description": "Switch to KobraNest once and reboot S1. Use only without an active print.",
  "version": "0.1.3",
  "properties": {
    "boot_confirmation": {
      "display": "Confirm reboot to KobraNest",
      "type": "enum",
      "options": [
        "False",
        "True"
      ],
      "default": "False"
    },
    "idle_confirmed": {
      "display": "Confirmed: No active print",
      "type": "enum",
      "options": [
        "False",
        "True"
      ],
      "default": "False"
    }
  }
}
