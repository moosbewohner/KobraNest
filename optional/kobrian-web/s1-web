def new_credentials(data):
    username = data.get('username', '')
    password = data.get('password', '')
    if not isinstance(username, str) or not re.fullmatch(r'[A-Za-z0-9_.-]{3,32}', username):
        raise ValueError('Benutzername: 3 bis 32 Zeichen, Buchstaben, Ziffern, Punkt, _ oder -.')
    if not isinstance(password, str) or not 8 <= len(password) <= 256:
        raise ValueError('Das Passwort muss 8 bis 256 Zeichen lang sein.')
    if password != data.get('password_repeat'):
        raise ValueError('Die Passwoerter stimmen nicht ueberein.')
    salt = secrets.token_bytes(16)
    return {'username': username, 'salt': salt.hex(), 'iterations': 100000,
            'password_hash': hashlib.pbkdf2_hmac('sha256', password.encode(), salt, 100000).hex(),
            'setup_required': False}


def save_credentials(credentials):
    updated = dict(CONFIG, **credentials)
    path = CONFIG_PATH
    pending = path.with_suffix('.account-new')
    with pending.open('w') as file:
        os.chmod(pending, 0o600)
        json.dump(updated, file, indent=2)
        file.write('\n')
        file.flush()
        os.fsync(file.fileno())
    os.replace(pending, path)
    os.sync()
    with AUTH_LOCK:
        CONFIG.update(updated)
        SESSIONS.clear()


