def printer_state():
    result = {'reachable': False, 'state': 'unknown', 'message': 'Pi/Moonraker nicht erreichbar',
              'print_state': 'unknown'}
    try:
        info = api('/server/info')
        result.update(reachable=True, state=info.get('klippy_state', 'unknown'),
                      message=info.get('klippy_state', 'unknown'))
        if result['state'] == 'ready':
            status = api('/printer/objects/query?webhooks&print_stats&extruder&heater_bed&virtual_sdcard')['status']
            stats = status.get('print_stats', {})
            result.update(print_state=stats.get('state', 'unknown'),
                          filename=stats.get('filename', ''),
                          duration=stats.get('print_duration', 0),
                          progress=status.get('virtual_sdcard', {}).get('progress'),
                          message=status.get('webhooks', {}).get('state_message', ''),
                          temperatures={name: {key: status.get(name, {}).get(key)
                                               for key in ('temperature', 'target')}
                                        for name in ('extruder', 'heater_bed')})
    except Exception:
        pass
    return result


def tcp_status():
    entries = []
    for line in read('/proc/net/tcp').splitlines()[1:]:
        fields = line.split()
        if len(fields) > 9:
            entries.append((int(fields[1].split(':')[1], 16), fields[3]))
    return {str(port): {'listening': (port, '0A') in entries,
                        'connected': (port, '01') in entries}
            for port in (22, 7003, 7005)}


def running(pidfile):
    value = read(pidfile)
    return value.isdigit() and Path('/proc/' + value).exists()


def tunnel_options():
    channels = {}
    for tty in Path('/sys/class/tty').glob('ttyACM*'):
        path = (tty / 'device').resolve()
        interface = next((p for p in (path, *path.parents) if (p / 'bInterfaceNumber').exists()), None)
        usb = next((p for p in (path, *path.parents) if (p / 'idVendor').exists()), None)
        if interface and usb and read(usb / 'idVendor').lower() == '1d6b' and read(usb / 'idProduct').lower() == '0104':
            number = read(interface / 'bInterfaceNumber')
            if number in ('00', '02'):
                channels.setdefault(number, []).append('/dev/' + tty.name)
    installed = (Path('/usr/local/sbin/s1-usb-bridge').is_file()
                 and '# Optional USB OTG transport' in read('/usr/local/sbin/s1-service'))
    usb_ready = installed and all(len(channels.get(number, [])) == 1 for number in ('00', '02'))
    lan_ready = read('/sys/class/net/eth1/carrier') == '1'
    configured = re.search(r'^PRINTER_IP=([0-9.]+)$', read('/etc/s1-network.conf'), re.M)
    network_ready = bool(configured) and any(item['carrier'] and configured[1] in item['addresses'] for item in network_interfaces() if item['name'] in ('eth1','wlan0'))
    return {'usb_installed': installed, 'usb_ready': usb_ready, 'lan_ready': lan_ready,
            'network_ready': network_ready, 'usb_devices': channels,
            'usb_message': ('Beide USB-Serial-Kanäle erkannt.' if usb_ready else
                            'USB-Erweiterung nicht installiert.' if not installed else
                            'Kein eindeutiges Pi-USB-Gadget mit beiden MCU-Kanälen erkannt.'),
            'usb_running': {name: running('/run/s1/' + name + '-usb.pid') for name in ('mcu1', 'mcu2')}}


def network_interfaces():
    try:
        entries = json.loads(command(['/usr/sbin/ip', '-j', '-4', 'addr', 'show']))
    except Exception:
        # The base image only includes BusyBox ip, without JSON output.
        import fcntl
        import struct
        entries = []
        with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as sock:
            for path in sorted(Path('/sys/class/net').iterdir()):
                entry = {'ifname': path.name, 'address': read(path / 'address'), 'addr_info': []}
                try:
                    result = fcntl.ioctl(sock.fileno(), 0x8915, struct.pack('256s', path.name.encode()[:15]))
                    entry['addr_info'].append({'local': socket.inet_ntoa(result[20:24])})
                except OSError:
                    pass  # Interface exists but has no IPv4 address.
                entries.append(entry)
    return [{'name': item['ifname'], 'mac': item.get('address', ''),
             'carrier': read('/sys/class/net/' + item['ifname'] + '/carrier') == '1',
             'addresses': [address['local'] for address in item.get('addr_info', [])]}
            for item in entries if item['ifname'] != 'lo']


