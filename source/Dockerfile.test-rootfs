FROM --platform=linux/arm/v7 debian:trixie-slim@sha256:a29215f6a35e51e22adffa17f89e9d2ef06214e64a2bad10d765c46aea49f11f
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends openssh-sftp-server && rm -rf /var/lib/apt/lists/*
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv python3-gi python3-cairo python3-gi-cairo gir1.2-gtk-3.0 gir1.2-vte-2.91 librsvg2-common xinput x11-xserver-utils busybox-static dropbear-bin tigervnc-standalone-server xauth fonts-dejavu-core ca-certificates git socat procps && rm -rf /var/lib/apt/lists/*
RUN apt-get update && apt-get install -y --no-install-recommends gcc libc6-dev python3-dev pkg-config libcairo2-dev libgirepository1.0-dev libsystemd-dev libmpv2 dbus dbus-x11 && rm -rf /var/lib/apt/lists/*
RUN git clone https://github.com/KlipperScreen/KlipperScreen.git /opt/KlipperScreen && cd /opt/KlipperScreen && git checkout 911c75bfc7658c0f5db39b39ee35910082e807f4 && python3 -m venv --system-site-packages /opt/ks-env && /opt/ks-env/bin/pip install --no-cache-dir -r scripts/KlipperScreen-requirements.txt
COPY KlipperScreen.conf /etc/KlipperScreen.conf
